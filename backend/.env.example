# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (Prisma) ---
# Local Postgres example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doc_intel_agent?schema=public"
# Supabase example (use the "connection pooling" URI from Project Settings > Database):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doc_intel_agent?schema=public"

# --- LLM ---
# Set MOCK_LLM=true to run the entire pipeline without any OpenAI API key.
# The MockLLMProvider returns deterministic, realistic extractions for the
# bundled sample invoices and reasonable generic output for anything else.
MOCK_LLM=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
